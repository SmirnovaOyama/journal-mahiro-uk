// The site on Cloudflare: a Worker that serves the built files in ./dist.
// Build first (npm run build), then deploy with `npx wrangler deploy`.
{
  "name": "journal-mahiro-uk",
  "compatibility_date": "2026-10-23",
  // Keep the journal-mahiro-uk.oyamasmirnona.workers.dev address answering too.
  "workers_dev": true,
  // Pages go through the Worker first, which writes each one's own title,
  // description and preview card into the HTML (worker/index.ts). Files
  // (scripts, data, pictures) are served straight from the build.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/s/*",
      "/mix",
      "/mix/*",
      "/kind/*",
      "/report/*",
      "/browse",
      "/saved",
      "/emergency",
      "/settings",
      "/settings/*",
      "/journal",
      "/journal/*",
      // A running night, a dose's own address, and a night someone shared.
      "/now",
      "/log",
      "/log/*",
      "/watch/*",
      // The app's own name and line, in the visitor's language.
      "/manifest.webmanifest",
      "/api/*"
    ]
  },
  // Accounts: who they are, their signed-in devices, and each one's journal,
  // encrypted in the browser before it's sent (worker/api.ts). The tables
  // are made by the files in migrations/:
  //   npx wrangler d1 migrations apply oyama-journal --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oyama-journal",
      "database_id": "0dfe8b13-4613-4736-9fd7-e4ea38b1f2b7",
      "migrations_dir": "migrations"
    }
  ],
  // Requests a minute, per key (an address, an account name, an account).
  // namespace_id only has to be unique in the Cloudflare account.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "3010", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SYNC", "namespace_id": "3060", "simple": { "limit": 60, "period": 60 } }
  ],
  // A preview of any branch but main (`npx wrangler preview`, which
  // Cloudflare's build runs for one) has none of production's bindings: no
  // accounts database, no rate limiters. Search, the mix checker and the
  // journal work in a preview; signing in says accounts aren't available
  // there (worker/api.ts), and nothing a preview does can reach a real
  // account. The block has to be here, even empty: without it that command
  // refuses to run, and every branch's build fails.
  "previews": {},
  // Every address the site answers on. Cloudflare makes the DNS records and
  // the certificates for these itself.
  "routes": [
    { "pattern": "journal.mahiro.uk", "custom_domain": true },
    { "pattern": "n55.mahiro.uk", "custom_domain": true },
    { "pattern": "od.mahiro.uk", "custom_domain": true },
    { "pattern": "trip.mahiro.uk", "custom_domain": true }
  ]
}
