{"id":"mt-45","name":"MT-45","form":"tablet","status":"Documented","aliases":"ic-6, mt45","category":"Opioid","summarySources":"TripSit","summary":"A synthetic opioid drug with the racemic potency being 80% potency of morphine orally. The drug was created by Dainippon Pharmaceutical in the 1970s. It has been used as a lead compound for the design of related substances. It has been associated with hearing and hair loss among other negative side effects. Structurally unrelated to most other opioid drugs. Caution is recommended especially with long-term use.","doseMaxTick":150,"doseUnit":"mg","doseRows":[{"roa":"Oral","source":"TripSit","unit":"mg","threshold":"30 mg","light":"30–45 mg","common":"45–60 mg","strong":"60 mg+","heavy":"60 mg+","commonEstimate":53,"band":{"low":45,"high":60},"domain":[24,132],"segments":{"light":[30,45],"common":[45,60],"strong":[60,60],"heavy":[60,126.72]}}],"durationSources":"TripSit","durationRows":[{"roa":"General","onset":"30–45 min","comeup":"—","peak":"—","offset":"—","afterEffects":"2–3 h","total":"4–6 h"}],"subjectiveEffects":[{"name":"Euphoria"},{"name":"Dry Mouth"},{"name":"Mood lift"},{"name":"Itchiness"},{"name":"Relaxant"},{"name":"Constipation"},{"name":"Pupil constriction"},{"name":"Analgesia"}],"combinations":[],"citations":[],"helpfulLinks":[{"title":"TripSit Factsheet","description":"Rapid harm-reduction summary and combination data","url":"https://drugs.tripsit.me/mt-45"},{"title":"Erowid Experience Vaults","description":"First-person experience reports and archives","url":"https://www.erowid.org/experiences/subs/exp_MT45.shtml"},{"title":"Wikipedia","description":"Encyclopedia article","url":"https://en.wikipedia.org/wiki/MT-45"},{"title":"Wikidata","description":"Structured data on MT-45","url":"https://www.wikidata.org/wiki/Q6718304"}],"wikidata":"Q6718304"}