{"id":"flutoprazepam","name":"Flutoprazepam","form":"tablet","status":"Documented","aliases":"restas","category":"Depressant","summarySources":"TripSit","summary":"A potent benzodiazepine that is roughly 4-5x the potency of diazepam and has a longer duration. The drug is rarely seen outside of Japan. The drug is reported to have sedative, hypnotic and anxiolytic effects. The drug may cause amnesia and loss of inhibitions in excess. It is not recommended to mix with other depressants.","advisory":"Avoid: All other CNS depressants.","doseMaxTick":8,"doseUnit":"mg","doseRows":[{"roa":"Oral","bioavailability":"TripSit reference","source":"TripSit","unit":"mg","light":"0.5–1 mg","common":"1.5–3 mg","strong":"3–5 mg+","heavy":"5 mg+","commonEstimate":2.25,"band":{"low":1.5,"high":3},"domain":[0.4,6.75],"segments":{"light":[0.5,1],"common":[1.5,3],"strong":[3,5],"heavy":[5,6.48]}}],"durationSources":"TripSit","durationRows":[{"roa":"General","onset":"15–45 min","comeup":"—","peak":"—","offset":"—","afterEffects":"24–36 h","total":"12–16 h"}],"subjectiveEffects":[{"name":"Anxiolytic"},{"name":"Sedative"},{"name":"Muscle Relaxant"},{"name":"Amnesia"},{"name":"Dystaxia"},{"name":"Hypnotic"}],"combinations":[],"citations":[],"helpfulLinks":[{"title":"TripSit Factsheet","description":"Rapid harm-reduction summary and combination data","url":"https://drugs.tripsit.me/flutoprazepam"},{"title":"Wikipedia","description":"Encyclopedia article","url":"https://en.wikipedia.org/wiki/Flutoprazepam"},{"title":"Wikidata","description":"Structured data on Flutoprazepam","url":"https://www.wikidata.org/wiki/Q5462983"}],"wikidata":"Q5462983"}