},{"name":"Memory suppression","url":"https://psychonautwiki.org/wiki/Memory_suppression"},{"name":"Mindfulness","url":"https://psychonautwiki.org/wiki/Mindfulness"},{"name":"Nausea","url":"https://psychonautwiki.org/wiki/Nausea"},{"name":"Novelty enhancement","url":"https://psychonautwiki.org/wiki/Novelty_enhancement"},{"name":"Pattern recognition enhancement","url":"https://psychonautwiki.org/wiki/Pattern_recognition_enhancement"},{"name":"Personal bias suppression","url":"https://psychonautwiki.org/wiki/Personal_bias_suppression"},{"name":"Perspective alterations","url":"https://psychonautwiki.org/wiki/Perspective_alterations"},{"name":"Pupil dilation","url":"https://psychonautwiki.org/wiki/Pupil_dilation"},{"name":"Runny nose","url":"https://psychonautwiki.org/wiki/Runny_nose"},{"name":"Salivation","url":"https://psychonautwiki.org/wiki/Salivation"},{"name":"Scenarios and plots","url":"https://psychonautwiki.org/wiki/Scenarios_and_plots"},{"name":"Scenery slicing","url":"https://psychonautwiki.org/wiki/Scenery_slicing"},{"name":"Sedation","url":"https://psychonautwiki.org/wiki/Sedation"},{"name":"Settings, sceneries, and landscapes","url":"https://psychonautwiki.org/wiki/Settings,_sceneries,_and_landscapes"},{"name":"Spirituality enhancement","url":"https://psychonautwiki.org/wiki/Spirituality_enhancement"},{"name":"Spontaneous tactile sensations","url":"https://psychonautwiki.org/wiki/Spontaneous_tactile_sensations"},{"name":"Subconscious communication","url":"https://psychonautwiki.org/wiki/Subconscious_communication"},{"name":"Symmetrical texture repetition","url":"https://psychonautwiki.org/wiki/Symmetrical_texture_repetition"},{"name":"Synaesthesia","url":"https://psychonautwiki.org/wiki/Synaesthesia"},{"name":"Thought connectivity","url":"https://psychonautwiki.org/wiki/Thought_connectivity"},{"name":"Time distortion","url":"https://psychonautwiki.org/wiki/Time_distortion"},{"name":"Tracers","url":"https://psychonautwiki.org/wiki/Tracers"},{"name":"Transformations","url":"https://psychonautwiki.org/wiki/Transformations"},{"name":"Visual distortion"},{"name":"Color enhancement"},{"name":"Sense of connectedness with nature"},{"name":"Sense of well-being"},{"name":"Sense of wonder"}],"combinations":[{"substance":"Lithium","status":"Dangerous","tone":"danger","note":"There are a large number of reports indicating a high seizure and psychosis risk from this combination."},{"substance":"Tramadol","status":"Unsafe","tone":"danger","note":"Tramadol is well known to lower seizure threshold and psychedelics also cause occasional seizures."},{"substance":"Amphetamines","status":"Caution","tone":"warning","note":"Stimulants increase anxiety levels and the risk of thought loops which can lead to negative experiences"},{"substance":"Cannabis","status":"Caution","tone":"warning","note":"Cannabis has an unexpectedly strong and somewhat unpredictable synergy with psychedelics."},{"substance":"Cocaine","status":"Caution","tone":"warning","note":"Stimulants increase anxiety levels and the risk of thought loops which can lead to negative experiences"},{"substance":"Diphenhydramine","status":"Caution","tone":"warning","note":"At 25-50mg, DPH may assist with side effects of the psilocybin such as nausea and anxiety. At higher dosages, the combination of a deliriant (DPH) and psilocybin is cautioned against. Psilocybin is likely to increase the deliriant and negative effects of DPH, in addition to increasing the risk of severe injury and mental trauma."},{"substance":"2C-T-x","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"2C-x","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"5-MeO-xxT","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"AMT","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"Dextromethorphan","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"DMT","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"DOx","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"Ketamine","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"LSD","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"MAOIs","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"MDMA","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"Mephedrone","status":"Synergy","tone":"info","note":"Stimulants increase anxiety levels and the risk of thought loops which can lead to negative experiences"},{"substance":"Mescaline","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"MXE","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"NBOMes","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"Nitrous","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"PCP","status":"Synergy","tone":"info","note":"TripSit classification: Low Risk & Synergy."},{"substance":"Pregabalin","status":"Synergy","tone":"info","note":"Pregabalin may reduce the anxiety and other possible side effects of Psilocybin Mushrooms. Additionally, the combination may increase inhibition, dizziness, and risk of injury."},{"substance":"Caffeine","status":"Low risk","tone":"positive","note":"TripSit classification: Low Risk & No Synergy."},{"substance":"Opioids","status":"Low risk","tone":"positive","note":"TripSit classification: Low Risk & No Synergy."},{"substance":"Alcohol","status":"Decrease","tone":"neutral","note":"TripSit classification: Low Risk & Decrease."},{"substance":"Benzodiazepines","status":"Decrease","tone":"neutral","note":"TripSit classification: Low Risk & Decrease."},{"substance":"Ghb / gbl","status":"Decrease","tone":"neutral","note":"TripSit classification: Low Risk & Decrease."},{"substance":"SSRIs","status":"Decrease","tone":"neutral","note":"TripSit classification: Low Risk & Decrease."}],"citations":[{"title":"A study done on psilocybin leads psychiatrists to believe there are implications that it may help to treat ptsd","url":"http://bjp.rcpsych.org/content/200/3/238.short"}],"helpfulLinks":[{"title":"TripSit Factsheet","description":"Rapid harm-reduction summary and combination data","url":"https://drugs.tripsit.me/mushrooms"},{"title":"Erowid Experience Vaults","description":"First-person experience reports and archives","url":"https://www.erowid.org/experiences/subs/exp_Psilocybin.shtml"},{"title":"維基百科","description":"zh:Encyclopedia article","url":"https://zh.wikipedia.org/zh-tw/%E8%95%88%E9%A1%9E"}],"pharmacology":{"text":"Psilocybin acts as a prodrug to psilocin, meaning it is inactive until it is converted into psilocin in the body. Upon entering the body, psilocybin is dephosphorylated to psilocin in the intestinal mucosa by alkaline phosphatase and nonspecific esterase.","source":"PsychonautWiki","page":"Psilocybin mushrooms","url":"https://psychonautwiki.org/wiki/Psilocybin_mushrooms#Pharmacology"},"uses":{"text":"Based on imagery found in prehistoric rock art, they are thought to have been used by various human cultures since before recorded history. Today, they are among the most widely used psychedelic substances (partly due to the ease of personal cultivation and harvesting).","source":"PsychonautWiki","page":"Psilocybin mushrooms","url":"https://psychonautwiki.org/wiki/Psilocybin_mushrooms"},"zh":"蕈類","summaryZh":"蕈類（英語：mushroom）又稱菇類、蕈菇、蘑菇，是泛稱大型真菌的肉質繁殖子實體，通常生長在土壤或其他食物來源的地上部分。其菌絲具橫隔壁，將菌絲分隔成多細胞，受到認為自身有危險的攻擊時，會散播孢子。毒蘑菇、毒蕈通常指有毒的蘑菇。蕈類於生態系中皆為分解者。"}