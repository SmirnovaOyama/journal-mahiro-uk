{"id":"3c-bz","name":"3C-BZ","form":"capsule","status":"Reference","source":"Wikidata","wikidata":"Q4636224","aliases":"3,5-dimethoxy-4-benzyloxyamphetamine, 4-benzyloxy-3,5-dimethoxyamphetamine","category":"Psychedelic","chemicalClass":"Substituted phenethylamines","groups":[],"atc":[],"summary":"3C-BZ, also known as 4-benzyloxy-3,5-dimethoxyamphetamine or as α-methylbenzscaline (3C-benzscaline), is a psychedelic drug of the phenethylamine, amphetamine, and 3C families related to 3,4,5-trimethoxyamphetamine (TMA). It is the amphetamine (3C) analogue of benzscaline. The drug was first synthesized by Alexander Shulgin and described in his 1991 book PiHKAL (Phenethylamines I Have Known and Loved).","summarySources":"Wikipedia","doseUnit":"","doseRows":[],"durationRows":[],"subjectiveEffects":[],"combinations":[],"citations":[],"helpfulLinks":[{"title":"Wikipedia","description":"Encyclopedia article","url":"https://en.wikipedia.org/wiki/3C-BZ"},{"title":"Wikidata","description":"Structured data on 3C-BZ","url":"https://www.wikidata.org/wiki/Q4636224"},{"title":"PubChem","description":"Chemistry, safety and literature","url":"https://pubchem.ncbi.nlm.nih.gov/compound/44350160"}],"formula":"C18H23NO3","molarMass":301.4,"pharmacology":{"kind":"Serotonergic psychedelic; Hallucinogen","body":[{"what":"onset","says":"30 minutes"},{"what":"lasts","says":"18–24 hours"}],"figures":"3C-BZ"},"uses":{"routes":"Oral","figures":"3C-BZ"}}