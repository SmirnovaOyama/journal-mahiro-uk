ychonautwiki.org/wiki/Irritability"},{"name":"Motivation enhancement","url":"https://psychonautwiki.org/wiki/Motivation_enhancement"},{"name":"Spontaneous tactile sensations","url":"https://psychonautwiki.org/wiki/Spontaneous_tactile_sensations"},{"name":"Stimulation","url":"https://psychonautwiki.org/wiki/Stimulation"},{"name":"Tactile enhancement","url":"https://psychonautwiki.org/wiki/Tactile_enhancement"},{"name":"Teeth grinding","url":"https://psychonautwiki.org/wiki/Teeth_grinding"},{"name":"Thought acceleration","url":"https://psychonautwiki.org/wiki/Thought_acceleration"},{"name":"Thought deceleration","url":"https://psychonautwiki.org/wiki/Thought_deceleration"},{"name":"Time distortion","url":"https://psychonautwiki.org/wiki/Time_distortion"},{"name":"Vasoconstriction","url":"https://psychonautwiki.org/wiki/Vasoconstriction"},{"name":"Vibrating vision","url":"https://psychonautwiki.org/wiki/Vibrating_vision"},{"name":"Wakefulness","url":"https://psychonautwiki.org/wiki/Wakefulness"},{"name":"Euphoria"},{"name":"Increased energy/alertness"},{"name":"Decreased need for sleep"},{"name":"Increased sociability"},{"name":"Mood lift"},{"name":"Excessive talking"},{"name":"Decreased appetite"},{"name":"Weight loss"},{"name":"Sweating"},{"name":"Disturbed sleep patterns"},{"name":"Bruxia"},{"name":"Visual and auditory hallucinations"},{"name":"Itchiness"},{"name":"Aggressiveness"},{"name":"Moodiness"}],"combinations":[{"substance":"25x-nboh","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"25x-nbome","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"5-htp","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"Dxm","status":"Unsafe","tone":"danger","note":"Documented unsafe interaction on PsychonautWiki."},{"substance":"MAOIs","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"MDMA","status":"Unsafe","tone":"danger","note":"Documented unsafe interaction on PsychonautWiki."},{"substance":"Serotonin releasers","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"Snris","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"SSRIs","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"Stimulants","status":"Unsafe","tone":"danger","note":"Documented unsafe interaction on PsychonautWiki."},{"substance":"Tramadol","status":"Dangerous","tone":"danger","note":"Documented dangerous interaction on PsychonautWiki."},{"substance":"Alcohol","status":"Caution","tone":"warning","note":"Uncertain or unpredictable interaction on PsychonautWiki."},{"substance":"Dissociatives","status":"Caution","tone":"warning","note":"Uncertain or unpredictable interaction on PsychonautWiki."},{"substance":"MXE","status":"Caution","tone":"warning","note":"Uncertain or unpredictable interaction on PsychonautWiki."}],"citations":[],"helpfulLinks":[{"title":"PsychonautWiki","description":"Pharmacology, subjective effects, and dosage reference","url":"https://psychonautwiki.org/wiki/A-PVP"},{"title":"TripSit Factsheet","description":"Rapid harm-reduction summary and combination data","url":"https://drugs.tripsit.me/a-pvp"},{"title":"Erowid Experience Vaults","description":"First-person experience reports and archives","url":"https://www.erowid.org/experiences/subs/exp_aPVP.shtml"},{"title":"Wikipedia","description":"Encyclopedia article","url":"https://en.wikipedia.org/wiki/%CE%91-Pyrrolidinopentiophenone"},{"title":"Wikidata","description":"Structured data on α-PVP","url":"https://www.wikidata.org/wiki/Q4734923"},{"title":"維基百科","description":"zh:Encyclopedia article","url":"https://zh.wikipedia.org/zh-tw/%CE%91-%E5%90%A1%E5%92%AF%E7%83%B7%E5%9F%BA%E8%8B%AF%E6%88%8A%E9%85%AE"}],"wikidata":"Q4734923","formula":"C15H21NO","molarMass":231.33,"pharmacology":{"text":"α-PVP acts as a potent norepinephrine–dopamine reuptake inhibitor (NDRI), similarly to other NDRIs like methylphenidate, cocaine, and methylenedioxypyrovalerone (MDPV). Its IC50 values have been found to be 14 to 70 nM for norepinephrine reuptake inhibition and 13 to 80 nM for dopamine reuptake inhibition in rat brain synaptosomes and human embryonic kidney 293 (HEK293) cells expressing the monoamine transporters (MATs).","source":"Wikipedia","page":"Α-Pyrrolidinopentiophenone","url":"https://en.wikipedia.org/wiki/%CE%91-Pyrrolidinopentiophenone#Pharmacodynamics","kind":"Stimulant; Norepinephrine–dopamine reuptake inhibitor (NDRI)","body":[{"what":"halfLife","says":"~2.1 hours"},{"what":"turnsInto","says":"α-PVP lactam, β-hydroxy α-PVP, and others"},{"what":"leaves","says":"In urine, through the kidneys"}],"figures":"Α-Pyrrolidinopentiophenone"},"uses":{"text":"α-PVP is used by a variety of different routes of administration, including oral, insufflation, injection, vaporization, sublingual, and rectal.","source":"Wikipedia","page":"Α-Pyrrolidinopentiophenone","url":"https://en.wikipedia.org/wiki/%CE%91-Pyrrolidinopentiophenone#Use_and_effects","routes":"By mouth, intranasal, inhalation, sublingual, intravenous","figures":"Α-Pyrrolidinopentiophenone"},"sideEffects":{"text":"α-PVP, like other stimulants, can cause hyperstimulation, paranoia, and hallucinations. α-PVP has been reported to be the cause, or a significant contributory cause of death in suicides and overdoses caused by combinations of drugs. α-PVP has also been linked to at least one death with pulmonary edema and moderately advanced atherosclerotic coronary artery disease when it was combined with pentedrone.","source":"Wikipedia","page":"Α-Pyrrolidinopentiophenone","url":"https://en.wikipedia.org/wiki/%CE%91-Pyrrolidinopentiophenone#Adverse_effects"},"summaryZh":"α-吡咯烷基苯戊酮，是一種合成的仿興奮劑卡西酮的化學物質，發展於1960年代。在化學上，夫拉卡與精神中樞興奮劑吡咯戊酮相關，在化學結構上是prolintane的酮類類似物。被用作娛樂性藥物。"}