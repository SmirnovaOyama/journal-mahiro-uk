nlm.nih.gov/pubmed/9600588"},{"title":"Alterations in responses to LSD in humans associated with chronic administration of tricyclic antidepressants, monoamine oxidase inhibitors or lithium...","url":"http://www.ncbi.nlm.nih.gov/pubmed/8788508"},{"title":"Chronic administration of serotonergic antidepressants attenuates the subjective effects of LSD in humans","url":"http://www.ncbi.nlm.nih.gov/pubmed/8726753"},{"title":"LSD toxicity: a suspected cause of death","url":"http://www.ncbi.nlm.nih.gov/pubmed/845494"},{"title":"Influence of naloxone on the effects of LSD in monkeys.","url":"http://www.ncbi.nlm.nih.gov/pubmed/6527737"},{"title":"Coma, hyperthermia and bleeding associated with massive LSD overdose. A report of eight cases","url":"http://www.ncbi.nlm.nih.gov/pubmed/4816396"},{"title":"Ascorbic acid antagonizes the behavioural effects of LSD in cats","url":"http://www.ncbi.nlm.nih.gov/pubmed/2868111"},{"title":"Illicit use of LSD or psilocybin, but not MDMA or nonpsychedelic drugs, is associated with mystical experiences in a dose-dependent manner","url":"http://www.ncbi.nlm.nih.gov/pubmed/23457892"},{"title":"New Onset LSD Flashback Syndrome Triggered by the Initiation of SSRIs","url":"http://www.ncbi.nlm.nih.gov/pubmed/21603479"},{"title":"LSD and tryptamine effects on sleep/wakefulness and electrocorticogram patterns in intact cats","url":"http://www.ncbi.nlm.nih.gov/pubmed/210478"},{"title":"Characterization of behavioral and endocrine effects of LSD on zebrafish","url":"http://www.ncbi.nlm.nih.gov/pubmed/20561961"},{"title":"Drug dreams in mescaline and LSD addiction","url":"http://www.ncbi.nlm.nih.gov/pubmed/20163393"},{"title":"Response of cluster headache to psilocybin and LSD","url":"http://www.ncbi.nlm.nih.gov/pubmed/16801660"},{"title":"LSD flashback syndrome exacerbated by selective serotonin reuptake inhibitor antidepressants in adolescents","url":"https://www.ncbi.nlm.nih.gov/pubmed/7965440"},{"title":"Metabolism of lysergic acid diethylamide (LSD) to 2-oxo-3-hydroxy LSD (O-H-LSD) in human liver microsomes and cryopreserved human hepatocytes","url":"https://www.ncbi.nlm.nih.gov/pubmed/11043658"},{"title":"LSD-induced entropic brain activity predicts subsequent personality change.","url":"https://www.ncbi.nlm.nih.gov/pubmed/27151536"}],"helpfulLinks":[{"title":"PsychonautWiki","description":"Pharmacology, subjective effects, and dosage reference","url":"https://psychonautwiki.org/wiki/LSD"},{"title":"TripSit Factsheet","description":"Rapid harm-reduction summary and combination data","url":"https://drugs.tripsit.me/lsd"},{"title":"Erowid Experience Vaults","description":"First-person experience reports and archives","url":"https://www.erowid.org/experiences/subs/exp_LSD.shtml"},{"title":"TiHKAL Entry","description":"Alexander & Ann Shulgin tryptamine monograph","url":"https://www.erowid.org/library/books_online/tihkal/tihkal26.shtml"},{"title":"Wikipedia","description":"Encyclopedia article","url":"https://en.wikipedia.org/wiki/LSD"},{"title":"Wikidata","description":"Structured data on LSD","url":"https://www.wikidata.org/wiki/Q23118"},{"title":"維基百科","description":"zh:Encyclopedia article","url":"https://zh.wikipedia.org/zh-tw/%E9%BA%A5%E8%A7%92%E9%85%B8%E4%BA%8C%E4%B9%99%E9%85%B0%E8%83%BA"}],"wikidata":"Q23118","formula":"C20H25N3O","molarMass":323.4,"pharmacology":{"text":"LSD is a serotonergic psychedelic and acts as a non-selective serotonin receptor modulator. It binds with high affinity to most of the serotonin receptors. The psychedelic effects of LSD are thought to be mediated specifically by activation of the serotonin 5-HT2A receptor. However, the role of other serotonin receptors and targets in the effects of LSD cannot be ruled out and may be considered likely.","source":"Wikipedia","page":"LSD","url":"https://en.wikipedia.org/wiki/LSD#Pharmacodynamics","kind":"Serotonin receptor agonist; Serotonin 5-HT2A receptor agonist; Serotonergic psychedelic; Hallucinogen","body":[{"what":"brokenDown","says":"Liver (CYP450)"},{"what":"turnsInto","says":"2-Oxo-3-hydroxy-LSD; 2-Oxo-LSD; LAE; LEO; Nor-LSD; 13-Hydroxy-LSD; 14-Hydroxy-LSD; Glucuronides"},{"what":"leaves","says":"Kidneys"}],"figures":"LSD"},"uses":{"text":"In recreational settings it is commonly administered via tabs of blotter paper. LSD is mainly used recreationally or for spiritual purposes. It became widely studied in the 1950s and 1960s.","recreational":"LSD is commonly used as a recreational drug for its psychedelic effects.","source":"Wikipedia","page":"LSD","url":"https://en.wikipedia.org/wiki/LSD","routes":"Oral","figures":"LSD"},"summaryZh":"麥角酸二乙醯胺，是一種強烈的半人工致幻劑和精神興奮劑。醫學界普遍認為LSD不會上癮。它由麥角酸中合成，對氧氣、紫外線與氯十分敏感（尤其是當LSD處於液態時）。純淨的LSD是一種無色、無氣味，味微苦的固體。"}